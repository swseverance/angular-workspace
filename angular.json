{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "apples": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/apples",
      "sourceRoot": "projects/apples/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/apples/src/main.ts",
            "tsConfig": "projects/apples/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/apples/public"
              }
            ],
            "styles": ["projects/apples/src/styles.css"],
            "outputPath": "dist",
            "server": "projects/apples/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/apples/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/apples/src/environments/environment.ts",
                  "with": "projects/apples/src/environments/environment.production.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/apples/src/environments/environment.ts",
                  "with": "projects/apples/src/environments/environment.development.ts"
                }
              ]
            },
            "local": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "local"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "apples:build:production"
            },
            "development": {
              "buildTarget": "apples:build:development"
            },
            "local": {
              "buildTarget": "apples:build:local",
              "port": 4200
            }
          },
          "defaultConfiguration": "local"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "oranges": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/oranges",
      "sourceRoot": "projects/oranges/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/oranges/src/main.ts",
            "tsConfig": "projects/oranges/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/oranges/public"
              }
            ],
            "styles": ["projects/oranges/src/styles.css"],
            "outputPath": "dist",
            "server": "projects/oranges/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/oranges/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/oranges/src/environments/environment.ts",
                  "with": "projects/oranges/src/environments/environment.production.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/oranges/src/environments/environment.ts",
                  "with": "projects/oranges/src/environments/environment.development.ts"
                }
              ]
            },
            "local": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "local"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "oranges:build:production"
            },
            "development": {
              "buildTarget": "oranges:build:development"
            },
            "local": {
              "buildTarget": "oranges:build:local",
              "port": 4201
            }
          },
          "defaultConfiguration": "local"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
